<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <permission
        android:name="com.sahl.permission.UNION"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.sahl.permission.UNION" />

    <queries>
        <package android:name="com.sahl.phone" />
        <package android:name="com.sahl.contacts" />
        <package android:name="com.sahl.messages" />
        <package android:name="com.sahl.camera" />
        <package android:name="com.sahl.gallery" />
        <package android:name="com.sahl.files" />
        <package android:name="com.sahl.adhan" />
        <package android:name="com.sahl.tools" />
        <package android:name="com.aly.sahlsync" />
        <package android:name="com.aly.trueqibla" />
        <package android:name="com.aly.sahlpdf" />
        <package android:name="com.sahl.pdf" />
        <package android:name="com.sahl.home" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Sahl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewerActivity"
            android:exported="true"
            android:theme="@style/SahlViewer"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:theme="@style/SahlViewer"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".CleanupActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".SahlCrashActivity"
            android:exported="false" />

        <receiver
            android:name=".UpdateCheckReceiver"
            android:exported="false" />

        <provider
            android:name=".UnionProvider"
            android:authorities="com.sahl.gallery.union"
            android:exported="true"
            android:readPermission="com.sahl.permission.UNION" />
    </application>
</manifest>
